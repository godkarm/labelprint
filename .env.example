# ============================================================
# LABELPRINT — Variables de Entorno
# ============================================================
# Copiar este archivo como .env y ajustar los valores.
# El archivo .env NO debe subirse a repositorios públicos.
# ============================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/labelprint/public

# Base de datos (XAMPP por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=labelprint
DB_USER=root
DB_PASS=

# Zona horaria
APP_TIMEZONE=America/Lima
